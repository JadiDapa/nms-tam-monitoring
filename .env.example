# ---- server ------------------------------------------------------------------------------------------------------
NODE_ENV=production
# Bind to loopback by default. Only change HOST if the engine sits on a private network behind a firewall.
HOST=127.0.0.1
PORT=8088
LOG_LEVEL=info

# ---- PostgreSQL --------------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/your_database
# The engine keeps ALL its tables in this schema, so it can share a database with other applications (e.g. Next.js/Prisma).
DATABASE_SCHEMA=nms_monitoring
DB_POOL_MAX=10
# Apply pending SQL migrations automatically on start (also available as: npm run migrate)
AUTO_MIGRATE=true

# ---- internal API authentication ---------------------------------------------------------------------------------
# Comma separated; every key must be >= 24 characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Several keys allow rotating without downtime (add the new key, deploy the callers, remove the old key).
ENGINE_API_KEYS=change-me-generate-a-long-random-key

# ---- secret encryption (AES-256-GCM) -----------------------------------------------------------------------------
# 32 random bytes, base64. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS KEY MAKES STORED SNMP/Telegram/webhook SECRETS UNRECOVERABLE. Back it up separately from the database.
ENGINE_ENCRYPTION_KEY=
ENGINE_ENCRYPTION_KEY_ID=k1
# To rotate: set a new ENGINE_ENCRYPTION_KEY + ID (k2) and list the previous one here as  k1:<base64>
ENGINE_ENCRYPTION_OLD_KEYS=

# ---- scheduler ---------------------------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Maximum simultaneous device polls (bounds SNMP sessions and ping processes)
SCHEDULER_CONCURRENCY=20
SCHEDULER_TICK_MS=1000
SCHEDULER_SYNC_INTERVAL_SEC=30
# A poll running longer than this is abandoned and the device becomes schedulable again
POLL_HARD_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=30000

# ---- notifications -----------------------------------------------------------------------------------------------
NOTIFICATION_WORKER_INTERVAL_MS=2000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SEC=30
NOTIFICATION_REQUEST_TIMEOUT_MS=8000
# Webhook targets that resolve to private/loopback/link-local addresses are blocked (SSRF protection).
# Set true only if your webhook receivers really live on your internal network.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ---- data retention ----------------------------------------------------------------------------------------------
METRICS_RETENTION_DAYS=30
RETENTION_INTERVAL_MIN=60

# ---- misc --------------------------------------------------------------------------------------------------------
# Concurrent POST /devices/test requests allowed (each one probes the network)
TEST_MAX_CONCURRENCY=5
