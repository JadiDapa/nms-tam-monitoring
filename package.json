{
  "name": "nms-monitoring",
  "version": "0.1.0",
  "description": "Standalone network monitoring engine (ICMP/TCP/SNMP polling, state machine, incidents, notifications)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/database/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "net-snmp": "^3.29.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
